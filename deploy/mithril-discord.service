[Unit]
Description=MithrilPF Discord community bot
After=network-online.target mithril-web.service
Wants=network-online.target

[Service]
Type=simple
User=mithril-discord
Group=mithril-discord
WorkingDirectory=/opt/mithril-discord/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/mithril-discord/current/src
LoadCredential=bot-token.txt:/etc/mithril-discord/bot-token.txt
LoadCredential=internal-secret.txt:/etc/mithril-discord/internal-secret.txt
ExecStart=/opt/mithril-discord/current/.venv/bin/python -m mithril_discord run --config /etc/mithril-discord/config.json
StateDirectory=mithril-discord
StateDirectoryMode=0700
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
